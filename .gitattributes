# Shell scripts, Python, SQL and config run inside Linux containers: force LF so
# a Windows checkout (core.autocrlf=true) does not break them with CRLF.
*.sh            text eol=lf
*.py            text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.xml           text eol=lf
*.txt           text eol=lf
*.md            text eol=lf
*.mmd           text eol=lf
Dockerfile      text eol=lf
.env.example    text eol=lf
.airflowignore  text eol=lf
*.xlsx          binary
*.png           binary
*.pptx          binary
