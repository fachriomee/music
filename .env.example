# =============================================================================
# .env.example — copy to .env and fill in the blanks (cp .env.example .env)
# -----------------------------------------------------------------------------
# Every credential of the platform lives in .env (never in code). For the
# internal passwords type any long random string, for example the output of
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
# AIRFLOW_FERNET_KEY must be 32 url-safe base64 bytes:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# =============================================================================

# Host / Compose
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
SUPERSET_PORT=8088
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# PostgreSQL (metadata DB for Airflow and Superset)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=
SUPERSET_DB_NAME=superset

# ClickHouse principals (admin / etl / read-only BI)
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_ETL_USER=etl
CLICKHOUSE_ETL_PASSWORD=
CLICKHOUSE_BI_USER=superset_ro
CLICKHOUSE_BI_PASSWORD=

# Airflow
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_UI_URL=http://localhost:8080

# Superset
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_UI_URL=http://localhost:8088

# E-mail alerts (task failure after the last retry + quarantined data)
ALERT_EMAIL_TO=fachrifa1898@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
# Gmail: 2-Step Verification + App Password (16 characters, no spaces)
SMTP_PASSWORD=
SMTP_MAIL_FROM=

# Catalog ("[DE TS] Songs Data"): file | gsheet_csv
CATALOG_SOURCE=file
CATALOG_FILE_PATH=/opt/airflow/data/catalog/DE_TS_Song_Catalog_Data.xlsx
CATALOG_SHEET_NAME=Data
GSHEET_ID=

# Spotify Web API (Client Credentials) — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=ID
SPOTIFY_SEARCH_LIMIT=10
SPOTIFY_ARTIST_QUERY_PAGES=1
SPOTIFY_MAX_PAGES=3
SPOTIFY_MIN_INTERVAL_SECONDS=0.25
SPOTIFY_REFRESH_DAYS=7

# YouTube Data API v3 (API key) — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=ID
YOUTUBE_MAX_RESULTS=50
YOUTUBE_VIDEO_CATEGORY_ID=10
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_QUOTA_SAFETY_RATIO=0.9
YOUTUBE_REFRESH_DAYS=30

# Pipeline behaviour
MAX_SONGS_PER_RUN=0
SCD_MAX_DELETE_RATIO=0.2
